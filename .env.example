# Copy this file to `.env` and fill in what applies to your deployment.
#
# Everything here is public: these values are baked into the built HTML, so never
# put a secret in this file. Anything left empty is hidden from the site instead
# of rendering a dead link. On Cloudflare Workers Builds, set the same names under
# Settings -> Environment variables, or the deployed site will hide them too.

# Contact address shown on the Contact and legal pages.
PUBLIC_CONTACT_EMAIL=contact@example.com

# Header "Buy me a coffee" button. Leave empty to hide it.
PUBLIC_COFFEE_URL=

# Footer community link (Discord or anything else). Leave empty to hide it.
PUBLIC_DISCORD_URL=

# Self-hosted Umami analytics. Set both to load the script; leave both empty for none.
PUBLIC_UMAMI_SRC=
PUBLIC_UMAMI_WEBSITE_ID=
