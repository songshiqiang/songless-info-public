---
import '../styles/global.css';
import { COFFEE_URL, DISCORD_URL, UMAMI_SRC, UMAMI_WEBSITE_ID } from '../data/site';
import { content } from '../i18n/content';
import { HTML_LANG, LOCALES, LOCALE_NAMES, OG_LOCALE, localePath, stripLocale, type Locale } from '../i18n/locales';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  jsonLd?: object[];
  /** Data files the page's game needs; fetched in parallel with the scripts. */
  preload?: string[];
  /** A not-found page has no versions in other languages to point at. */
  notFound?: boolean;
}

const { locale, title, description, jsonLd = [], preload = [], notFound = false } = Astro.props;
const c = content[locale].layout;
// The build sees /unlimited.html and /index.html; the site is served at /unlimited and /.
const pathname = Astro.url.pathname.replace(/\.html$/, '').replace(/\/(index)?$/, '') || '/';
const canonical = new URL(pathname, Astro.site);
const ogImage = new URL('/og-image.png', Astro.site);
const nav = [
  { href: localePath(locale, '/'), label: c.nav.daily },
  { href: localePath(locale, '/unlimited'), label: c.nav.unlimited },
  { href: localePath(locale, '/party'), label: c.nav.party }
];
const basePath = stripLocale(canonical.pathname);
const alternates = LOCALES.map((l) => ({ locale: l, path: localePath(l, basePath), href: new URL(localePath(l, basePath), Astro.site).href }));
const defaultHref = new URL(basePath, Astro.site).href;
---

<!doctype html>
<html lang={HTML_LANG[locale]} data-locale={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {
      // English pages send a visitor to their language: their saved choice, or on the first visit
      // their browser's. Client-side only, so crawlers and direct links reach every language.
      locale === 'en' && !notFound && (
        <script is:inline>
          (function () {
            try {
              if (/bot|crawl|spider|slurp|lighthouse/i.test(navigator.userAgent)) return;
              var saved = localStorage.getItem('songless:lang');
              if (!saved) {
                var l = (navigator.language || '').toLowerCase();
                saved = /^zh/.test(l) ? 'zh' : /^ru/.test(l) ? 'ru' : /^pt/.test(l) ? 'pt-br' : 'en';
                localStorage.setItem('songless:lang', saved);
              }
              if (/^(zh|ru|pt-br)$/.test(saved)) {
                var p = location.pathname;
                location.replace('/' + saved + (p === '/' ? '' : p) + location.search + location.hash);
              }
            } catch (e) {}
          })();
        </script>
      )
    }
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {!notFound && alternates.map((a) => <link rel="alternate" hreflang={HTML_LANG[a.locale]} href={a.href} />)}
    {!notFound && <link rel="alternate" hreflang="x-default" href={defaultHref} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#ffffff" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={OG_LOCALE[locale]} />
    <meta property="og:site_name" content="Songless" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={c.ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    {UMAMI_SRC && UMAMI_WEBSITE_ID && (
      <script is:inline defer src={UMAMI_SRC} data-website-id={UMAMI_WEBSITE_ID}></script>
    )}
    {preload.map((href) => <link rel="preload" href={href} as="fetch" crossorigin="anonymous" />)}
    <slot name="head" />
    <!-- Fonts load without blocking the first paint; system fonts show until they arrive. -->
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;700&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
  </head>
  <body>
    <header class="site-header">
      <a href={localePath(locale, '/')} class="logo">
        <svg width="32" height="32" viewBox="0 0 32 32" aria-hidden="true">
          <circle cx="16" cy="16" r="15" fill="none" stroke="currentColor" stroke-width="2"></circle>
          <path d="M9 18v-4M13 21v-10M17 19v-6M21 22v-12M25 18v-4" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
        </svg>
        <span>Songless</span>
      </a>
      <nav aria-label={c.mainNav} class="site-nav">
        {nav.map((n) => <a href={n.href} aria-current={pathname === n.href ? 'page' : undefined}>{n.label}</a>)}
      </nav>
      {COFFEE_URL && (
      <a href={COFFEE_URL} class="coffee-link" aria-label={c.coffee} title={c.coffee} target="_blank" rel="noopener" data-umami-event="buy-me-a-coffee">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M17 8h1a4 4 0 0 1 0 8h-1"></path>
          <path d="M3 8h14v9a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4z"></path>
          <path d="M6 2v2M10 2v2M14 2v2"></path>
        </svg>
        <span>{c.coffee}</span>
      </a>
      )}
      <details class="lang-menu">
        <summary aria-label={c.language}>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="9"></circle>
            <path d="M3 12h18M12 3c2.5 2.6 3.8 5.6 3.8 9s-1.300 6.400-3.800 9c-2.500-2.600-3.800-5.600-3.800-9S9.500 5.600 12 3z"></path>
          </svg>
          {LOCALE_NAMES[locale]}
        </summary>
        <ul>
          {
            alternates.map((a) => (
              <li>
                <a href={a.path} hreflang={HTML_LANG[a.locale]} lang={HTML_LANG[a.locale]} data-lang={a.locale} aria-current={a.locale === locale ? 'true' : undefined}>
                  {LOCALE_NAMES[a.locale]}
                </a>
              </li>
            ))
          }
        </ul>
      </details>
    </header>
    <div class="page">
      <slot />
    </div>
    <script is:inline>
      (function () {
        var menu = document.querySelector('.lang-menu');
        menu.addEventListener('click', function (e) {
          var a = e.target.closest && e.target.closest('a[data-lang]');
          if (!a) return;
          // A new language brings its own country to the Daily Ladder, over a saved choice or a link's.
          var changed = a.dataset.lang !== document.documentElement.dataset.locale;
          try {
            localStorage.setItem('songless:lang', a.dataset.lang);
            if (changed) localStorage.removeItem('songless:daily-chart');
          } catch (err) {}
          var query = new URLSearchParams(location.search);
          if (changed) query.delete('chart');
          var search = query.toString();
          // Same page in the new language, keeping a room code, ?ladder= and the like.
          var base = location.pathname.replace(/^\/(zh|ru|pt-br)(?=\/|$)/, '') || '/';
          var prefix = a.dataset.lang === 'en' ? '' : '/' + a.dataset.lang;
          a.href = (prefix + (base === '/' && prefix ? '' : base)) + (search ? '?' + search : '') + location.hash;
        });
        document.addEventListener('click', function (e) {
          if (menu.open && !menu.contains(e.target)) menu.open = false;
        });
        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape' && menu.open) {
            menu.open = false;
            menu.querySelector('summary').focus();
          }
        });
      })();
    </script>
    <footer class="site-footer">
      <div class="wrap footer-inner">
        <div class="footer-col">
          <a href={localePath(locale, '/')} class="footer-brand">Songless</a>
          <span>{c.tagline}</span>
          {DISCORD_URL && (
          <a href={DISCORD_URL} class="footer-discord" target="_blank" rel="noopener" aria-label="Discord" title="Discord">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M20.317 4.37a19.8 19.8 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.3 18.3 0 0 0-5.487 0 12.6 12.6 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.7 19.7 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.08.08 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.08.08 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994a.076.076 0 0 0-.041-.106 13.1 13.1 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10 10 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.3 12.3 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.8 19.8 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.06.06 0 0 0-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"></path>
            </svg>
          </a>
          )}
        </div>
        <div class="footer-col footer-col-end">
          <nav aria-label={c.siteNav} class="footer-links">
            <a href={localePath(locale, '/about')}>{c.about}</a>
            <a href={localePath(locale, '/contact')}>{c.contact}</a>
            <a href={localePath(locale, '/privacy')}>{c.privacy}</a>
            <a href={localePath(locale, '/terms')}>{c.terms}</a>
          </nav>
          <span>{c.credit}</span>
        </div>
      </div>
    </footer>
  </body>
</html>
